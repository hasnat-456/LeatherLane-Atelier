<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | LeatherLane Atelier</title>
    <link rel="stylesheet" href="css/global.css">
    <style>
        .auth-layout {
            display: flex;
            min-height: 100vh;
        }

        .auth-image {
            flex: 1;
            background-color: var(--secondary-bg);
            background-image: linear-gradient(rgba(43, 29, 23, 0.4), rgba(43, 29, 23, 0.8)), url('https://images.unsplash.com/photo-1616422285623-14ff81f4a9df?q=80&w=2072&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        .auth-image-content {
            text-align: center;
            color: var(--primary-text);
            max-width: 400px;
        }

        .auth-image-content h2 {
            font-size: 3rem;
            margin-bottom: 20px;
            color: var(--primary-gold);
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }

        .auth-form-container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            position: relative;
        }

        .auth-card {
            background-color: var(--secondary-bg);
            width: 100%;
            max-width: 480px;
            padding: 48px;
            border-radius: var(--radius);
            box-shadow: 0 20px 40px var(--shadow);
            border: 1px solid var(--borders);
        }

        .auth-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .auth-logo {
            font-family: var(--font-heading);
            font-size: 2rem;
            color: var(--primary-gold);
            margin-bottom: 16px;
            display: block;
        }

        .auth-subtitle {
            color: var(--secondary-text);
            margin-top: 8px;
            font-size: 0.95rem;
        }

        .back-to-login {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 24px;
            font-size: 0.9rem;
            color: var(--secondary-text);
        }

        .back-to-login a {
            margin-left: 8px;
            font-weight: 600;
        }

        .success-message {
            display: none;
            background-color: rgba(46, 107, 77, 0.15);
            border: 1px solid var(--success);
            color: #79D1A5;
            padding: 16px;
            border-radius: var(--radius);
            margin-bottom: 24px;
            text-align: center;
            font-size: 0.9rem;
        }

        .auth-footer {
            position: absolute;
            bottom: 24px;
            text-align: center;
            width: 100%;
            left: 0;
            color: var(--secondary-text);
            font-size: 0.85rem;
        }

        @@media (max-width: 992px) {
            .auth-image {
                display: none;
            }
            .auth-form-container {
                background-image: linear-gradient(rgba(43, 29, 23, 0.85), rgba(43, 29, 23, 0.95)), url('https://images.unsplash.com/photo-1616422285623-14ff81f4a9df?q=80&w=2072&auto=format&fit=crop');
                background-size: cover;
                background-position: center;
            }
            .auth-card {
                background-color: rgba(74, 46, 36, 0.95);
                backdrop-filter: blur(10px);
            }
        }
        @@media (max-width: 480px) {
            .auth-card {
                padding: 32px 24px;
            }
        }
    </style>
</head>
<body>

    <div class="auth-layout">
        <div class="auth-image fade-in">
            <div class="auth-image-content">
                <h2>Secure Your Legacy</h2>
                <p>Regain access to your account and continue your journey with our premium leather goods.</p>
            </div>
        </div>

        <div class="auth-form-container">
            <div class="auth-card slide-up">
                <div class="auth-header">
                    <a href="/" class="auth-logo">LeatherLane Atelier</a>
                    <h2>Reset Password</h2>
                    <p class="auth-subtitle">Enter your email address and we'll send you a link to reset your password.</p>
                </div>

                <div id="successMessage" class="success-message">
                    If an account exists for this email, a reset link has been sent. Please check your inbox.
                </div>

                <form id="forgotPasswordForm">
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" class="form-control" placeholder="Enter your email" required>
                    </div>

                    <button type="submit" class="btn-primary" id="submitBtn">Send Reset Link</button>

                    <div class="back-to-login">
                        Remember your password? <a href="/login">Back to Login</a>
                    </div>
                </form>
            </div>

            <div class="auth-footer fade-in">
                &copy; 2026 LeatherLane Atelier. All rights reserved.
            </div>
        </div>
    </div>

    <script src="js/app.js"></script>
    <script>
        document.getElementById('forgotPasswordForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const email = document.getElementById('email').value;
            if (email) {
                const btn = document.getElementById('submitBtn');
                btn.textContent = 'Sending...';
                btn.style.opacity = '0.8';
                
                // Simulate API call
                setTimeout(() => {
                    btn.textContent = 'Send Reset Link';
                    btn.style.opacity = '1';
                    document.getElementById('successMessage').style.display = 'block';
                    document.getElementById('email').value = '';
                    
                    // For demo purposes, redirect to the reset password page after 3 seconds
                    // In a real app, this would happen via email link
                    setTimeout(() => {
                        window.location.href = '/reset-password';
                    }, 3000);
                }, 1500);
            }
        });
    </script>
</body>
</html>
