<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | LeatherLane Atelier</title>
    <link rel="stylesheet" href="css/global.css">
    <style>
        .auth-layout {
            display: flex;
            min-height: 100vh;
        }

        .auth-image {
            flex: 1;
            background-color: var(--secondary-bg);
            background-image: linear-gradient(rgba(43, 29, 23, 0.4), rgba(43, 29, 23, 0.8)), url('https://images.unsplash.com/photo-1590874987771-460eb85038b3?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        .auth-image-content {
            text-align: center;
            color: var(--primary-text);
            max-width: 400px;
        }

        .auth-image-content h2 {
            font-size: 3rem;
            margin-bottom: 20px;
            color: var(--primary-gold);
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }

        .auth-form-container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            position: relative;
        }

        .auth-card {
            background-color: var(--secondary-bg);
            width: 100%;
            max-width: 480px;
            padding: 48px;
            border-radius: var(--radius);
            box-shadow: 0 20px 40px var(--shadow);
            border: 1px solid var(--borders);
        }

        .auth-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .auth-logo {
            font-family: var(--font-heading);
            font-size: 2rem;
            color: var(--primary-gold);
            margin-bottom: 16px;
            display: block;
        }

        .auth-subtitle {
            color: var(--secondary-text);
            margin-top: 8px;
        }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
            font-size: 0.9rem;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            cursor: pointer;
            color: var(--secondary-text);
        }

        .checkbox-label input {
            margin-right: 8px;
            accent-color: var(--primary-gold);
            width: 16px;
            height: 16px;
        }

        .password-input-wrapper {
            position: relative;
        }

        .toggle-password {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--primary-gold);
            cursor: pointer;
            font-size: 0.9rem;
            padding: 4px;
        }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 32px 0;
            color: var(--borders);
        }
        
        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid var(--borders);
        }

        .divider span {
            padding: 0 16px;
            color: var(--secondary-text);
            font-size: 0.9rem;
        }

        .auth-footer {
            position: absolute;
            bottom: 24px;
            text-align: center;
            width: 100%;
            left: 0;
            color: var(--secondary-text);
            font-size: 0.85rem;
        }

        @@media (max-width: 992px) {
            .auth-image {
                display: none;
            }
            .auth-form-container {
                background-image: linear-gradient(rgba(43, 29, 23, 0.85), rgba(43, 29, 23, 0.95)), url('https://images.unsplash.com/photo-1590874987771-460eb85038b3?q=80&w=2070&auto=format&fit=crop');
                background-size: cover;
                background-position: center;
            }
            .auth-card {
                background-color: rgba(74, 46, 36, 0.95);
                backdrop-filter: blur(10px);
            }
        }
        @@media (max-width: 480px) {
            .auth-card {
                padding: 32px 24px;
            }
        }
    </style>
</head>
<body>

    <div class="auth-layout">
        <div class="auth-image fade-in">
            <div class="auth-image-content">
                <h2>Timeless Elegance</h2>
                <p>Discover our exclusive collection of handcrafted leather goods, designed for those who appreciate the finer things in life.</p>
            </div>
        </div>

        <div class="auth-form-container">
            <div class="auth-card slide-up">
                <div class="auth-header">
                    <span class="auth-logo">LeatherLane Atelier</span>
                    <h2>Welcome Back</h2>
                    <p class="auth-subtitle">Sign in to continue to your account.</p>
                </div>

                <form id="loginForm" action="/login" method="post">
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email" required aria-label="Email Address">
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="password-input-wrapper">
                            <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required aria-label="Password">
                            <button type="button" class="toggle-password" onclick="togglePassword('password')" aria-label="Show password">Show</button>
                        </div>
                    </div>

                    <div class="form-options">
                        <label class="checkbox-label">
                            <input type="checkbox"> Remember Me
                        </label>
                        <a href="/forgot-password" class="forgot-link">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn-primary">Sign In</button>

                    <div class="divider"><span>OR</span></div>

                    <a href="/signup" class="btn-secondary">Create Account</a>
                </form>
            </div>

            <div class="auth-footer fade-in">
                &copy; 2026 LeatherLane Atelier. All rights reserved.
            </div>
        </div>
    </div>

    <script src="js/app.js"></script>
</body>
</html>
