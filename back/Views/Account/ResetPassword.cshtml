<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Password | LeatherLane Atelier</title>
    <link rel="stylesheet" href="css/global.css">
    <style>
        .auth-layout {
            display: flex;
            min-height: 100vh;
        }

        .auth-image {
            flex: 1;
            background-color: var(--secondary-bg);
            background-image: linear-gradient(rgba(43, 29, 23, 0.4), rgba(43, 29, 23, 0.8)), url('https://images.unsplash.com/photo-1490209428590-798835e39665?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        .auth-image-content {
            text-align: center;
            color: var(--primary-text);
            max-width: 400px;
        }

        .auth-image-content h2 {
            font-size: 3rem;
            margin-bottom: 20px;
            color: var(--primary-gold);
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }

        .auth-form-container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            position: relative;
        }

        .auth-card {
            background-color: var(--secondary-bg);
            width: 100%;
            max-width: 480px;
            padding: 48px;
            border-radius: var(--radius);
            box-shadow: 0 20px 40px var(--shadow);
            border: 1px solid var(--borders);
        }

        .auth-header {
            text-align: center;
            margin-bottom: 32px;
        }

        .auth-logo {
            font-family: var(--font-heading);
            font-size: 2rem;
            color: var(--primary-gold);
            margin-bottom: 16px;
            display: block;
        }

        .auth-subtitle {
            color: var(--secondary-text);
            margin-top: 8px;
            font-size: 0.95rem;
        }

        .password-input-wrapper {
            position: relative;
        }

        .toggle-password {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--primary-gold);
            cursor: pointer;
            font-size: 0.9rem;
            padding: 4px;
        }
        
        .password-strength {
            height: 4px;
            background-color: var(--input-bg);
            border-radius: 2px;
            margin-top: 8px;
            overflow: hidden;
            display: none;
        }

        .password-strength-bar {
            height: 100%;
            width: 0%;
            transition: all 0.3s ease;
        }

        .strength-weak { width: 33%; background-color: var(--error); }
        .strength-medium { width: 66%; background-color: var(--primary-gold); }
        .strength-strong { width: 100%; background-color: var(--success); }

        .password-feedback {
            font-size: 0.8rem;
            margin-top: 4px;
            display: block;
        }

        .input-error {
            border-color: var(--error) !important;
        }
        
        .error-message {
            color: #FFFFFF;
            font-size: 0.8rem;
            margin-top: 4px;
            display: none;
        }

        .auth-footer {
            position: absolute;
            bottom: 24px;
            text-align: center;
            width: 100%;
            left: 0;
            color: var(--secondary-text);
            font-size: 0.85rem;
        }

        @@media (max-width: 992px) {
            .auth-image {
                display: none;
            }
            .auth-form-container {
                background-image: linear-gradient(rgba(43, 29, 23, 0.85), rgba(43, 29, 23, 0.95)), url('https://images.unsplash.com/photo-1490209428590-798835e39665?q=80&w=2070&auto=format&fit=crop');
                background-size: cover;
                background-position: center;
            }
            .auth-card {
                background-color: rgba(74, 46, 36, 0.95);
                backdrop-filter: blur(10px);
            }
        }
        @@media (max-width: 480px) {
            .auth-card {
                padding: 32px 24px;
            }
        }
    </style>
</head>
<body>

    <div class="auth-layout">
        <div class="auth-form-container">
            <div class="auth-card slide-up">
                <div class="auth-header">
                    <a href="/" class="auth-logo">LeatherLane Atelier</a>
                    <h2>Create New Password</h2>
                    <p class="auth-subtitle">Your new password must be different from previous used passwords.</p>
                </div>

                <form id="resetPasswordForm">
                    <div class="form-group">
                        <label for="newPassword">New Password</label>
                        <div class="password-input-wrapper">
                            <input type="password" id="newPassword" class="form-control" placeholder="Enter new password" required>
                            <button type="button" class="toggle-password" onclick="togglePassword('newPassword')">Show</button>
                        </div>
                        <div class="password-strength" id="strengthContainer">
                            <div class="password-strength-bar" id="strengthBar"></div>
                        </div>
                        <span class="password-feedback" id="strengthFeedback"></span>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Confirm Password</label>
                        <div class="password-input-wrapper">
                            <input type="password" id="confirmPassword" class="form-control" placeholder="Confirm new password" required>
                            <button type="button" class="toggle-password" onclick="togglePassword('confirmPassword')">Show</button>
                        </div>
                        <span class="error-message" id="matchError">Passwords do not match</span>
                    </div>

                    <button type="submit" class="btn-primary" id="submitBtn">Reset Password</button>
                </form>
            </div>

            <div class="auth-footer fade-in">
                &copy; 2026 LeatherLane Atelier. All rights reserved.
            </div>
        </div>
        
        <div class="auth-image fade-in">
            <div class="auth-image-content">
                <h2>Uncompromising Quality</h2>
                <p>True luxury requires dedication to every detail. Your security is as important as our craftsmanship.</p>
            </div>
        </div>
    </div>

    <script src="js/app.js"></script>
    <script>
        const resetForm = document.getElementById('resetPasswordForm');
        const passInput = document.getElementById('newPassword');
        const confirmInput = document.getElementById('confirmPassword');
        const strengthContainer = document.getElementById('strengthContainer');
        const strengthBar = document.getElementById('strengthBar');
        const strengthFeedback = document.getElementById('strengthFeedback');
        const matchError = document.getElementById('matchError');

        passInput.addEventListener('input', function() {
            const val = this.value;
            if(val.length > 0) {
                strengthContainer.style.display = 'block';
                let strength = 0;
                if(val.length >= 8) strength++;
                if(/[A-Z]/.test(val) && /[0-9]/.test(val)) strength++;
                if(/[^A-Za-z0-9]/.test(val)) strength++;
                
                strengthBar.className = 'password-strength-bar';
                if(strength === 0 || strength === 1) {
                    strengthBar.classList.add('strength-weak');
                    strengthFeedback.textContent = 'Weak - Must be at least 8 characters';
                    strengthFeedback.style.color = 'var(--error)';
                } else if (strength === 2) {
                    strengthBar.classList.add('strength-medium');
                    strengthFeedback.textContent = 'Good';
                    strengthFeedback.style.color = 'var(--primary-gold)';
                } else {
                    strengthBar.classList.add('strength-strong');
                    strengthFeedback.textContent = 'Strong';
                    strengthFeedback.style.color = 'var(--success)';
                }
            } else {
                strengthContainer.style.display = 'none';
                strengthFeedback.textContent = '';
            }
            checkMatch();
        });

        confirmInput.addEventListener('input', checkMatch);

        function checkMatch() {
            if(confirmInput.value.length > 0) {
                if(passInput.value !== confirmInput.value) {
                    confirmInput.classList.add('input-error');
                    matchError.style.display = 'block';
                } else {
                    confirmInput.classList.remove('input-error');
                    matchError.style.display = 'none';
                }
            }
        }

        resetForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            if(!passInput.value || passInput.value.length < 8) {
                passInput.classList.add('input-error');
                return;
            }

            if(passInput.value !== confirmInput.value) {
                confirmInput.classList.add('input-error');
                matchError.style.display = 'block';
                return;
            }

            const btn = document.getElementById('submitBtn');
            btn.textContent = 'Updating...';
            btn.style.opacity = '0.8';
            
            setTimeout(() => {
                // Success! Redirect to login
                window.location.href = '/login';
            }, 1500);
        });
    </script>
</body>
</html>
